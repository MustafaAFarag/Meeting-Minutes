{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Notes",
  "version": "0.1.0",
  "identifier": "com.ctchealth.meeting-notes",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Meeting Notes",
        "width": 180,
        "height": 34,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "resizable": true,
        "maximizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
